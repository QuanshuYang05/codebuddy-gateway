{
  "name": "codebuddy-gateway",
  "version": "0.1.2",
  "private": true,
  "author": "kakaoy",
  "description": "WorkBuddy / CodeBuddy 中转网关桌面版：本地 OpenAI 兼容网关 + 实时中转状态控制台",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuanshuYang05/codebuddy-gateway.git"
  },
  "homepage": "https://github.com/QuanshuYang05/codebuddy-gateway",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "smoke": "node scripts/smoke-test.js",
    "build": "node scripts/build.js",
    "dist": "node scripts/build.js --win",
    "build:mac": "node scripts/build.js --mac",
    "build:linux": "node scripts/build.js --linux",
    "make:icons": "node scripts/make-icons.js",
    "publish:github": "node scripts/publish.js"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.workbuddy.gateway",
    "productName": "WorkBuddy 中转网关",
    "copyright": "Copyright © 2026",
    "icon": "resources/icon.ico",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "src/launcher.py",
        "to": "launcher.py"
      },
      {
        "from": "build/kernel",
        "to": "kernel"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": "nsis",
      "artifactName": "codebuddy-gateway-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkBuddy 中转网关",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "artifactName": "codebuddy-gateway-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon-256.png",
      "artifactName": "codebuddy-gateway-${version}-${arch}.${ext}",
      "maintainer": "kakaoy",
      "synopsis": "WorkBuddy / CodeBuddy 中转网关桌面版",
      "description": "本地 OpenAI 兼容网关与实时中转状态控制台"
    }
  }
}
