{
  "name": "@quanshuyang05/codebuddy-gateway-panel",
  "version": "0.2.0",
  "type": "module",
  "description": "WorkBuddy / CodeBuddy relay gateway in the DSH sidebar: bundled runtime, works right after install",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuanshuYang05/codebuddy-gateway.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/QuanshuYang05/codebuddy-gateway/tree/main/dsh-plugin",
  "bugs": {
    "url": "https://github.com/QuanshuYang05/codebuddy-gateway/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "codebuddy",
    "workbuddy",
    "gateway"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "scripts/*.ps1",
    "payload/**",
    "README.md",
    "PREREQUISITES.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "meta": {
    "title": "Gateway Panel",
    "description": "View and control the CodeBuddy gateway from the sidebar."
  }
}
